{
  "manifest_version": 3,
  "name": "LagZero",
  "version": "0.1.0",
  "description": "Local-first AI browser assistant for resilient web content reuse.",
  "permissions": [
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open LagZero Sidebar"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
